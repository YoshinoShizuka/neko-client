{
  "schemaVersion": 1,
  "id": "neko_client",
  "version": "${version}",
  "name": "Neko Client",
  "description": "虚空仓库客户端增强：搜索框（中文 / 拼音 / 注册名）+ Ctrl+Alt+左键 把一格物品取出到背包放不下为止（常规模式纯散货、潜影盒模式满盒）。开关与热键由 malilib 提供（必需）。纯客户端模组，服务端需搭配 carpet-Neko-Addition 1.0.16+。",
  "authors": [
    "Akirono"
  ],
  "license": "MIT",
  "icon": "assets/neko_client/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "neko.client.VoidWarehouseSearchClient"
    ]
  },
  "mixins": [
    "neko_client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.1.2",
    "fabric-api": "*",
    "malilib": ">=0.28.0"
  },
  "suggests": {
    "carpet_neko_addition": "*"
  }
}
